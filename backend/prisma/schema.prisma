// 영천 홍보지도 앱 — DB 모델 정본 (설명서: docs/ERD_v5.md)
// 변경은 이 파일 → `prisma migrate dev` 순서로만. (수동 DB 편집·db push 금지)
// 표기 규칙: Prisma 모델/필드는 camelCase, 실제 컬럼·테이블은 @map/@@map 으로 snake_case 유지.

// Prisma 7: 연결 URL은 prisma.config.ts 에서 읽고, 클라이언트는 src/generated/prisma 로 생성된다(커밋 제외).
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// 회원 (v3 유지 테이블. v3 ERD 원문이 없어 API 명세 v3가 요구하는 최소 컬럼으로 정의)
// ---------------------------------------------------------------------------

model User {
  userId       String   @id @default(dbgenerated("gen_random_uuid()")) @map("user_id") @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  name         String   @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  profile      UserProfile?
  sessions     Session[]
  places       Place[]
  stories      Story[]
  metrics      UserMetric[]
  achievements UserAchv[]

  @@map("user")
}

model UserProfile {
  userId     String  @id @map("user_id") @db.Uuid
  profileUrl String? @map("profile_url") @db.VarChar(500) // 외부 스토리지 URL
  bio        String? @db.VarChar(255)

  user User @relation(fields: [userId], references: [userId])

  @@map("user_profile")
}

// refresh 토큰 보관 (POST /auth/refresh)
model Session {
  sessionId        String   @id @default(dbgenerated("gen_random_uuid()")) @map("session_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  refreshTokenHash String   @map("refresh_token_hash") @db.VarChar(255)
  expiresAt        DateTime @map("expires_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [userId])

  @@index([userId])
  @@map("session")
}

// ---------------------------------------------------------------------------
// 장소 (ERD v5: 시대 제거 → 장소 = 좌표 + 지금 이름)
// ---------------------------------------------------------------------------

model Place {
  placeId      String   @id @default(dbgenerated("gen_random_uuid()")) @map("place_id") @db.Uuid
  name         String   @db.VarChar(150) // 지금 이름
  usageType    String?  @map("usage_type") @db.VarChar(100) // 용도 = 카테고리 겸용
  intro        String?
  latitude     Float
  longitude    Float
  address      String?  @db.VarChar(255)
  sinceYear    Int?     @map("since_year") // 개업연도(연식 표시)
  thumbnailUrl String?  @map("thumbnail_url") @db.VarChar(500)
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  creator     User?        @relation(fields: [createdBy], references: [userId])
  stories     Story[]
  eventPlaces EventPlace[]

  @@index([latitude, longitude])
  @@map("place")
}

// ---------------------------------------------------------------------------
// 스토리 (사진+글 통합 UGC). place 또는 event 중 최소 하나에 귀속
// 앵커 규칙은 Prisma로 강제 불가 → service 계층에서 검증
// 기억 날짜: memoryDate(패턴)가 원천. 나머지 memory* 5개는 memory-date.resolver 가 계산한 파생값(정렬용)
// ---------------------------------------------------------------------------

model Story {
  storyId           String   @id @default(dbgenerated("gen_random_uuid()")) @map("story_id") @db.Uuid
  placeId           String?  @map("place_id") @db.Uuid
  eventId           String?  @map("event_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  memoryDate        String   @default("XXXX.XX.XX") @map("memory_date") @db.Char(10) // YYYY.MM.DD, X=모름
  memoryDateFrom    DateTime @map("memory_date_from") @db.Date
  memoryDateTo      DateTime @map("memory_date_to") @db.Date
  memoryYearFrom    Int      @map("memory_year_from")
  memoryYearTo      Int      @map("memory_year_to")
  memoryYearUnknown Boolean  @map("memory_year_unknown")
  placeNameThen     String?  @map("place_name_then") @db.VarChar(150) // 그때 이 자리의 이름
  content           String? // NULL 허용(사진만)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  place  Place?       @relation(fields: [placeId], references: [placeId])
  event  Event?       @relation(fields: [eventId], references: [eventId])
  user   User         @relation(fields: [userId], references: [userId])
  photos StoryPhoto[]

  // 타임라인 정렬(ERD v5 §3)용 복합 인덱스
  @@index([placeId, memoryYearUnknown, memoryYearFrom, memoryYearTo, memoryDateFrom, memoryDateTo], map: "story_place_timeline_idx")
  @@index([eventId, memoryYearUnknown, memoryYearFrom, memoryYearTo, memoryDateFrom, memoryDateTo], map: "story_event_timeline_idx")
  @@index([userId])
  @@map("story")
}

model StoryPhoto {
  storyPhotoId String   @id @default(dbgenerated("gen_random_uuid()")) @map("story_photo_id") @db.Uuid
  storyId      String   @map("story_id") @db.Uuid
  imageUrl     String   @map("image_url") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  story Story @relation(fields: [storyId], references: [storyId], onDelete: Cascade)

  @@index([storyId])
  @@map("story_photo")
}

// ---------------------------------------------------------------------------
// 이벤트 · 축제 (v5: 지도 핀 위치 추가, 기록은 event 에 직접 연결)
// ---------------------------------------------------------------------------

model Event {
  eventId   String   @id @default(dbgenerated("gen_random_uuid()")) @map("event_id") @db.Uuid
  name      String   @db.VarChar(150)
  content   String?
  latitude  Float? // 지도 핀 대표 위치. 없으면 지도에 안 뜸
  longitude Float?
  address   String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  hosts       EventHost[]
  occurrences EventOccurrence[]
  photos      EventPhoto[]
  stories     Story[]

  @@map("event")
}

model EventHost {
  eventHostId String @id @default(dbgenerated("gen_random_uuid()")) @map("event_host_id") @db.Uuid
  eventId     String @map("event_id") @db.Uuid
  hostType    String @map("host_type") @db.VarChar(50) // '지자체' 등
  hostName    String @map("host_name") @db.VarChar(150)

  event Event @relation(fields: [eventId], references: [eventId])

  @@index([eventId])
  @@map("event_host")
}

model EventPhoto {
  eventPhotoId String   @id @default(dbgenerated("gen_random_uuid()")) @map("event_photo_id") @db.Uuid
  eventId      String   @map("event_id") @db.Uuid
  imageUrl     String   @map("image_url") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  event Event @relation(fields: [eventId], references: [eventId])

  @@index([eventId])
  @@map("event_photo")
}

// 매년 회차 (개최 기간·장소 정보용. 기록은 회차가 아니라 event 에 붙는다)
model EventOccurrence {
  occurrenceId String    @id @default(dbgenerated("gen_random_uuid()")) @map("occurrence_id") @db.Uuid
  eventId      String    @map("event_id") @db.Uuid
  year         Int
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date

  event  Event        @relation(fields: [eventId], references: [eventId])
  places EventPlace[]

  @@index([eventId])
  @@map("event_occurrence")
}

// 회차 ↔ 개최 장소
model EventPlace {
  occurrenceId String @map("occurrence_id") @db.Uuid
  placeId      String @map("place_id") @db.Uuid

  occurrence EventOccurrence @relation(fields: [occurrenceId], references: [occurrenceId])
  place      Place           @relation(fields: [placeId], references: [placeId])

  @@id([occurrenceId, placeId])
  @@map("event_place")
}

// ---------------------------------------------------------------------------
// 게임화 (지표 · 뱃지) (v3 유지)
// ---------------------------------------------------------------------------

model MetricType {
  code String @id @db.VarChar(50) // 'story_count'
  name String @db.VarChar(100) // '올린 스토리'

  userMetrics UserMetric[]
  achvs       Achv[]

  @@map("metric_type")
}

model UserMetric {
  userId     String   @map("user_id") @db.Uuid
  metricCode String   @map("metric_code") @db.VarChar(50)
  value      Int      @default(0)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user   User       @relation(fields: [userId], references: [userId])
  metric MetricType @relation(fields: [metricCode], references: [code])

  @@id([userId, metricCode])
  @@map("user_metric")
}

model Achv {
  achvId     String @id @default(dbgenerated("gen_random_uuid()")) @map("achv_id") @db.Uuid
  achvName   String @map("achv_name") @db.VarChar(100)
  tier       String @db.VarChar(20) // 'bronze' | 'silver' | 'gold'
  metricCode String @map("metric_code") @db.VarChar(50)
  threshold  Int // 이 값 이상이면 획득

  metric    MetricType @relation(fields: [metricCode], references: [code])
  userAchvs UserAchv[]

  @@map("achv")
}

model UserAchv {
  userId     String   @map("user_id") @db.Uuid
  achvId     String   @map("achv_id") @db.Uuid
  achievedAt DateTime @default(now()) @map("achieved_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [userId])
  achv Achv @relation(fields: [achvId], references: [achvId])

  @@id([userId, achvId])
  @@map("user_achv")
}
