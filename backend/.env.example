# 복사해서 .env 로 사용 (.env 는 커밋 금지)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yeongcheonmap?schema=public
PORT=8080
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# 수집가 등록(가입) 허용. 전시 기간엔 false — 수집가 계정 하나로만 기록 (플레이스토어 배포 때 true)
SIGNUP_ENABLED=false
# (선택) 시드 사용자 '수집가'(seed@yeongcheonmap.local) 로그인 비밀번호. npm run prisma:seed 때 반영
SEED_USER_PASSWORD=
# (선택) true 면 seed 때 가상 샘플(○○카페 등)도 넣는다. 데모·발표 DB 에서는 비워 둔다
SEED_SAMPLE_DATA=
# (선택) 영천 장소 검색용 NAVER API HUB 키 — NCP 콘솔 > NAVER API HUB > Subscription 신청 > Application 등록(검색 '지역' 선택)
# > Application Management > [인증 정보]. 지도 키(NAVER_MAP_CLIENT_ID)와는 다른 키. 서버에만 둔다(앱에 넣지 않음)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# 외부 스토리지 (upload 모듈 구현 시 사용, 지금은 미사용)
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
