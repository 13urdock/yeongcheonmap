# 서버용 비밀값. 이 파일을 복사해 deploy/.env 로 만들고 채운다 (.env 는 커밋 금지)
# 비밀값 만들기: openssl rand -hex 32   (영문·숫자만 나와서 URL 에 넣어도 안전)

# HTTPS 를 받을 주소 (DNS A 레코드가 이 서버 고정 IP 를 가리켜야 함)
APP_DOMAIN=map.burdocklab.com

# PostgreSQL 비밀번호 — 영문·숫자만 (DATABASE_URL 안에 들어가므로 특수문자 금지)
POSTGRES_PASSWORD=

# JWT 서명 키 (서로 다른 값)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# 전시 기간엔 false — 수집가 계정 하나로만 기록
SIGNUP_ENABLED=false

# 수집가(seed@yeongcheonmap.local) 로그인 비밀번호. seed 실행 때 반영
SEED_USER_PASSWORD=

# 영천 장소 검색 (NAVER API HUB '지역' 키, backend/.env 와 같은 값)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# 사진 저장소 (NCP Ncloud Storage, API 명세 §8). 키는 Ncloud Storage 권한만 준 Sub Account 키 권장
STORAGE_ENDPOINT=https://kr.ncloudstorage.com
STORAGE_REGION=kr
STORAGE_BUCKET=yeongcheonmap
STORAGE_PUBLIC_BASE_URL=https://yeongcheonmap.kr.ncloudstorage.com
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
